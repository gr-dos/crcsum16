#!/bin/sh
#
# Fetch the pinned revision of libc16 (github.com/gr-dos/libc16) into DIR
# and build it there; libc16's own make fetches its pinned Open Watcom
# and JWasm into DIR/build/tools. Reuses DIR if it is already at the pin.
#
# usage: scripts/fetch-libc16 [DIR]     (default: build/libc16)

set -eu

repo=https://github.com/gr-dos/libc16.git
rev=8cde3bd60a6f09dfa7fe754618b24b45f665376f

dir=${1:-build/libc16}

if [ "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" != "$rev" ]; then
  if [ ! -d "$dir/.git" ]; then
    mkdir -p "$dir"
    git -C "$dir" init -q
  fi
  git -C "$dir" fetch -q --depth 1 "$repo" "$rev"
  git -C "$dir" checkout -q --detach "$rev"
fi
make -C "$dir"
